# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/backend/*.log
/backend/*.checkpoint.ndjson
/backend/run-youtube-*.ps1
# Artefactos efímeros de enriquecimiento/descarga del catálogo. Los scripts
# fuente de backend/src/modules/music sí se conservan para futuras corridas.
/backend/catalog-*.log
/backend/catalog-*.checkpoint.ndjson

# env files (can opt-in for committing if needed)
.env*
!/backend/.env.example
!/frontend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
