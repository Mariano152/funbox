    "catalog:embed": "tsx src/modules/music/catalog-embed.ts",
    "catalog:progress": "tsx src/modules/music/catalog-progress.ts",
    "catalog:youtube": "tsx src/modules/music/catalog-youtube-fill.ts",
    "catalog:youtube:progress": "tsx src/modules/music/catalog-youtube-progress.ts",
    "catalog:youtube:views": "tsx src/modules/music/catalog-youtube-views.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.4",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
