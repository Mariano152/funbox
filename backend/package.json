{
  "name": "@funbox/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:check": "tsx src/database/check-connection.ts",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "knownness:recalculate": "tsx src/modules/music/knownness-recalculate.ts",
    "embedding-cache:stats": "tsx src/modules/music/embedding-cache-stats.ts",
    "catalog:import": "tsx src/modules/music/catalog-bulk-import.ts",
    "catalog:audit": "tsx src/modules/music/catalog-audit.ts",
    "catalog:prune-youtube": "tsx src/modules/music/catalog-prune-youtube.ts",
    "catalog:calibrate-listenbrainz": "tsx src/modules/music/listenbrainz-calibration.ts",
    "catalog:fill-successes": "tsx src/modules/music/catalog-success-fill.ts",
    "catalog:fill-successes:progress": "tsx src/modules/music/catalog-success-progress.ts",
    "catalog:genres": "tsx src/modules/music/catalog-genre-enrich.ts",
